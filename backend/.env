# backend/.env (local)
PORT=5000
HOST=0.0.0.0

# Orígenes permitidos (dev + producción). Separar con espacio, coma o punto y coma.
CORS_ORIGIN=http://localhost:5173 http://127.0.0.1:5173 https://vps.hazlosoftware.com https://www.vps.hazlosoftware.com

# Firebird (usa tus credenciales; aquí uso los que me diste)
FB_HOST=vps.hazlosoftware.com
FB_PORT=3050
FB_DATABASE_1=C:\Manager-app\BDatos\NORMANDY_PLANTA.GDB
FB_DATABASE_2=C:\Manager-app\BDatos\NORMANDY_LOCATIVOS.GDB
FB_DATABASE_3=C:\Manager-app\BDatos\NORMANDY_METROLOGIA.GDB
FB_USER=SYSDBA
FB_PASSWORD=masterkey
FB_POOL_SIZE=5
# Charset cliente Firebird + decode/encode Node (evita Ã³ en observaciones)
FB_ENCODING=WIN1252
FB_STRING_DECODE=latin1

SHOW_SQL=true

# Raíz de uploads. Subcarpetas: Fotos_OTM/ y Firma_Personal/
# VPS (debe coincidir con el alias nginx /uploads/): UPLOADS_DIR=C:\Manager-app\uploads
UPLOADS_DIR=D:\Productos_web\Manager\manager-tablet\Uploads
