# Variables de desarrollo para Vite
# Rutas relativas: Vite proxy (/api -> localhost:5000) evita CORS en desarrollo
VITE_API_URL=/api
VITE_API_URL_DB_1=/api
VITE_API_URL_DB_2=/api
VITE_API_URL_DB_3=/api
VITE_APP_NAME=Manager (dev)
VITE_UPLOADS_URL=/uploads

# Nombres en /select-database (el número = perfil db1/db2/db3 en la UI; el orden de lineas no importa)
VITE_DB_1_DESCRIPTION=Mantenimiento Planta
VITE_DB_2_DESCRIPTION=Mantenimiento Locativos
VITE_DB_3_DESCRIPTION=Mantenimiento Metrología

